# Copy to .env and fill in BOTH values — the scripts require the endpoint
# explicitly (no default).
#
# Either form works; the runner normalises. The official client wants the /v0.5
# suffix (it strips the version for the versionless /agents API and keeps it for
# /v0.5/files), so passing a bare root straight to the client breaks uploads with
# an empty `ApiError: {}` while bundle calls keep working.
#
# API keys are deployment-scoped: a key issued for one deployment returns 401
# against another.

ATAI_API_KEY=
ATAI_API_ENDPOINT=https://api.u1.archetypeai.app
