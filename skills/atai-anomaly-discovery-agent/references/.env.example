# Copy to .env IN THIS DIRECTORY — the runner reads ./.env from where it runs
# (the file is gitignored). Both are required; there is no default endpoint.
#
# Either form works; the runner normalises. The official client wants the /v0.5
# suffix (it keeps the version for /v0.5/files and strips it for the versionless
# /agents), so passing a bare root straight to the client breaks uploads with an
# empty `ApiError: {}` while bundle calls keep working.
#
# API keys are deployment-scoped: a key issued for one deployment 401s against
# another.
ATAI_API_KEY=<your API key>
ATAI_API_ENDPOINT=https://api.u1.archetypeai.app
