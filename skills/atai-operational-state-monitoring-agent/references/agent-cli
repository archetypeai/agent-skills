def cmd_bundles_list(args):
    status, payload = request(
        "GET", "/bundle", query={"limit": args.limit, "after": args.after})
    payload = check(status, payload)
    if maybe_json(args, payload):
        return
    items = payload.get("data", [])
    section(f"Bundles ({len(items)})")
    rows = []
    for b in items:
        rows.append((
            dim(b.get("id", "-")),
            b.get("name", "-"),
            dim(b.get("blueprint_id", "-")),
            b.get("model") or dim("(default)"),
            color_status(b.get("status", "-")),
            dim(short_time(b.get("created_at"))),
        ))
    table(rows, ["ID", "NAME", "BLUEPRINT_ID", "MODEL", "STATUS", "CREATED"])
    if payload.get("has_more"):
        print(dim(f"\n  … more available (pass --after {items[-1].get('id')})"))


