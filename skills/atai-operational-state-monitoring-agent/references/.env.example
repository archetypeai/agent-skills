# Copy to .env and fill in BOTH values (no default endpoint). The scripts read the
# nearest .env from the folder they run in upwards (one at the repo root serves
# every skill; it is gitignored), and a variable already set in your shell wins.
#
# The root, with or without /api: the scripts reduce it to a root and append /api,
# where both API surfaces live (/api/agents, /api/files).
#
# API keys are deployment-scoped: a key issued for one deployment returns 401
# against another.

ATAI_API_KEY=
ATAI_API_ENDPOINT=https://platform.u1.archetypeai.app
