# Copy to .env and fill in BOTH values — the scripts require the endpoint
# explicitly (no default). A trailing /vX.Y is tolerated and stripped: the
# agent API is versionless (/agents), the files API is at /v0.5/files.
# The pre-packaged "OSM Quick Start" bundles are verified on the Dev and
# Staging deployments (api.dev.u1 / api.stage.u1.archetypeai.app).

ATAI_API_KEY=
ATAI_API_ENDPOINT=https://api.dev.u1.archetypeai.app
