# Copy to .env IN THIS DIRECTORY — the runner reads ./.env from where it runs
# (the file is gitignored). Both are required; there is no default endpoint.
#
# Any form works; the runner reduces it to a root and appends /api, where both
# API surfaces live (/api/agents, /api/files). The client uses api_endpoint
# verbatim, so a wrong prefix 404s every call as a bodyless `ApiError: {}`.
#
# API keys are deployment-scoped: a key issued for one deployment 401s against
# another.
ATAI_API_KEY=<your API key>
ATAI_API_ENDPOINT=https://platform.u1.archetypeai.app
