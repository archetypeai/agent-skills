# Copy to .env and fill in. Auto-loaded via python-dotenv if installed.

# Archetype AI Newton (Omega) — both required, no default endpoint.
ATAI_API_KEY=
ATAI_API_ENDPOINT=https://api.u1.archetypeai.app/v0.5

# NVIDIA hosted API — create at https://build.nvidia.com/settings/api-keys.
# An NGC key (for pulling containers) also starts with nvapi- but gets 403 here.
NVIDIA_API_KEY=

# Optional overrides
# NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1
