# Copy to .env IN THIS DIRECTORY — the runner reads ./.env from where it runs
# (the file is gitignored). Both are required; there is no default endpoint.
#
# The pre-packaged "AD Quick Start" bundles are published on the production
# deployment. API keys are deployment-scoped: a key issued for one deployment
# returns 401 against another.
ATAI_API_KEY=<your API key>
ATAI_API_ENDPOINT=https://api.u1.archetypeai.app
