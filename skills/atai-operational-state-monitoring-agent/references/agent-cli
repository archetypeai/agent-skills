def agents_for_bundle(bundle_id):
    """Every agent belonging to `bundle_id`, across all pages.

    The list endpoint's `query` is a loose substring match (name/id/bundle/
    blueprint), so we filter down to an exact bundle_id match to drop any
    coincidental hits.
    """
    return [a for a in paginate("/instances", {"query": bundle_id})
            if a.get("bundle_id") == bundle_id]


def _delete_agent_once(agent_id, org_id=None):
    """Delete one agent, cancelling it first if it isn't in a terminal state.

    Returns (ok: bool, detail: str). Never exits — callers aggregate results so
    one bad agent doesn't abort a whole cascade.

    `org_id` targets another org's agent (superadmin only). The cancel endpoint
    is always org-scoped (no cross-org support), so a non-terminal agent in
    another org can't be cancelled here — we report that instead of firing a
    cancel at the caller's own org.
    """
    status, payload = request("DELETE", f"/instances/{agent_id}",
                              query={"org_id": org_id})
    if is_ok(status):
        return True, "deleted"
    # 409 => not terminal. Cancel (running/paused -> canceled, synchronously)
    # then retry the delete once — but only for own-org agents.
    if status == 409:
        if org_id is not None:
            return False, ("still active and in another org; cross-org cancel is "
                           "unsupported, so cancel/delete it with that org's key first")
        cst, cpl = request("POST", f"/instances/{agent_id}/cancel")
        if not is_ok(cst):
            return False, "cancel failed: " + fmt_error(cst, cpl).replace("\n", " ")
        status, payload = request("DELETE", f"/instances/{agent_id}")
        if is_ok(status):
            return True, "cancelled then deleted"
    return False, fmt_error(status, payload).replace("\n", " ")


def delete_agents(agents, cross_org=False) -> bool:
    """Delete every agent in `agents`, reporting each. Returns True iff all went.

    With `cross_org`, each agent is deleted in its own org (taken from its
    `org_id` field) — used when a superadmin clears another org's blockers.
    """
    all_ok = True
    for a in agents:
        aid = a.get("id", "?")
        org = a.get("org_id") if cross_org else None
        ok, detail = _delete_agent_once(aid, org)
        if ok:
            print(green(f"  deleted agent {aid}") + dim(f"  ({detail})"))
        else:
            all_ok = False
            print(red(f"  failed to delete agent {aid}: ") + detail)
    return all_ok


def cmd_agents_delete(args):
    # A plain delete succeeds for terminal agents. If the agent is still active
    # the server returns 409; rather than silently cancel a running agent, show
    # what it is and ask before cancelling + deleting it.
    status, payload = request("DELETE", f"/instances/{args.agent_id}")
    if is_ok(status):
        print(green(f"deleted agent {args.agent_id}"))
        return
    if status == 409:
        st, ap = request("GET", f"/instances/{args.agent_id}")
        cur = ap.get("status") if is_ok(st) and isinstance(ap, dict) else "?"
        print(yellow(f"agent {args.agent_id} is not terminal (status="
                     f"{color_status(cur)}); it must be cancelled before deletion"))
        if not confirm("Cancel and delete it?", args.yes):
            die("aborted; nothing deleted", code=2)
        ok, detail = _delete_agent_once(args.agent_id)
        if ok:
            print(green(f"deleted agent {args.agent_id}") + dim(f"  ({detail})"))
            return
        die(detail, code=2)
    check(status, payload)


