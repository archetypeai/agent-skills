# Copy to .env IN THIS DIRECTORY — the runner reads ./.env from where it
# runs (the file is gitignored). Both are required — there is no default
# endpoint. The pre-packaged "RED Quick Start" bundles currently live on
# the Dev deployment.
ATAI_API_KEY=<your dev API key>
ATAI_API_ENDPOINT=https://api.dev.u1.archetypeai.app
