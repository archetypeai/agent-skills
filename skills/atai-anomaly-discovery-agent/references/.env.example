# Copy to .env IN THIS DIRECTORY — the runner reads ./.env from where it runs
# (the file is gitignored). Both are required; there is no default endpoint.
#
# Everything in this skill is verified against the Dev deployment — the
# pre-packaged "AD Quick Start" bundles currently live there.
ATAI_API_KEY=<your dev API key>
ATAI_API_ENDPOINT=https://api.dev.u1.archetypeai.app
