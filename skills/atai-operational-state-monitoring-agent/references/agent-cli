def cmd_bundles_create(args):
    structured = (args.blueprint or args.name or args.values or args.artifacts
                  or args.description is not None or args.model)
    if args.body is not None:
        if structured:
            die("--body is exclusive with --blueprint/--name/--values/"
                "--artifacts/--description/--model")
        body = read_body(args)
    else:
        if not args.blueprint or not args.name:
            die("--blueprint and --name are required (or pass a full --body)")
        body = {"blueprint": args.blueprint, "name": args.name}
        if args.description is not None:
            body["description"] = args.description
        if args.model:
            body["model"] = args.model
        if args.values:
            body["values"] = parse_kv(args.values, "--values")
        if args.artifacts:
            body["artifacts"] = parse_kv(args.artifacts, "--artifacts")
    status, payload = request("POST", "/bundle", body=body)
    payload = check(status, payload)
    if maybe_json(args, payload):
        return
    print(green("created bundle ") + bold(payload.get("id", "?")) +
          f"  name={payload.get('name')}  status={color_status(payload.get('status'))}")


def _delete_bundle_once(bundle_id, org_id=None):
    """DELETE one bundle. Returns (ok, status, payload) without exiting.

    `org_id` targets another org's bundle (superadmin only); omit for own org
    (the param is dropped from the query when None, so behavior is unchanged).
    """
    status, payload = request("DELETE", f"/bundle/{bundle_id}",
                              query={"org_id": org_id})
    return is_ok(status), status, payload


def cmd_bundles_delete(args):
    ok, status, payload = _delete_bundle_once(args.bundle_id)
    if ok:
        print(green(f"deleted bundle {args.bundle_id}"))
        return

    # A 409 conflict on a bundle delete means agents still pin it (the only FK
    # into bundles). Offer to delete those agents first, then retry.
    if status == 409 and "conflict" in error_codes(payload):
        agents = agents_for_bundle(args.bundle_id)
        if not agents:
            # Blocked, but we can't find the offending agents — surface the raw
            # error rather than pretend we can cascade.
            die(fmt_error(status, payload) +
                dim(f"\n  (no agents found for bundle {args.bundle_id}; nothing to cascade)"),
                code=2)
        section(f"Bundle {bold(args.bundle_id)} is still referenced by "
                f"{len(agents)} agent(s):")
        table([_agent_row(a) for a in agents],
              ["ID", "NAME", "STATUS", "BLUEPRINT", "BUNDLE_ID", "CREATED"])
        if not confirm(f"Delete these {len(agents)} agent(s), then the bundle?",
                       args.yes):
            die("aborted; nothing deleted", code=2)
        if not delete_agents(agents):
            die("some agents could not be deleted; bundle left in place", code=2)
        ok, status, payload = _delete_bundle_once(args.bundle_id)
        check(status, payload)
        print(green(f"deleted bundle {args.bundle_id}"))
        return

    check(status, payload)  # any other error → exit


def cmd_bundles_run(args):
    if args.body is not None:
        if args.source or args.sink:
            die("--body is exclusive with --source/--sink")
        body = read_body(args)
    else:
        if not args.source:
            die("--source is required (or pass a full --body)")
        connectors = {"source": parse_file_refs(args.source, "--source")}
        if args.sink:
            connectors["sink"] = {"type": "file", "id": args.sink}
        body = {"connectors": connectors}
    status, payload = request("POST", f"/bundle/{args.bundle_id}/run", body=body)
    payload = check(status, payload)
    if maybe_json(args, payload):
        return
    print(green("started agent ") + bold(payload.get("id", "?")) +
          f"  status={color_status(payload.get('status'))}")


