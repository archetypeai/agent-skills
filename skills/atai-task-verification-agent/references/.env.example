# Both variables are required — there is no default endpoint.
#
# Any form works; the runner reduces it to a root and appends /api, where every
# surface lives (/api/projects, /api/agents, /api/files).
#
# API keys are deployment-scoped: a key issued for one deployment 401s against
# another. The runner records what it builds per deployment root in
# tva-lifecycle.json, so switching endpoints never reuses another one's ids.
ATAI_API_KEY=<your API key>
ATAI_API_ENDPOINT=https://platform.u1.archetypeai.app
