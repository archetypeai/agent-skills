# Copy to .env IN THIS DIRECTORY — the runner reads ./.env from where it
# runs (the file is gitignored). Both are required — there is no default
# endpoint. The pre-packaged "RED Quick Start" bundles are verified on the
# Dev and Staging deployments (api.dev.u1 / api.stage.u1.archetypeai.app).
ATAI_API_KEY=<your API key for that environment>
ATAI_API_ENDPOINT=https://api.dev.u1.archetypeai.app
