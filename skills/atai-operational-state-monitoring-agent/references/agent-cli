# ---- body loading for create/run -------------------------------------------
def read_text(src):
    """Read a file path (or `-` for stdin) as raw text."""
    if src == "-":
        return sys.stdin.read()
    try:
        with open(src) as f:
            return f.read()
    except OSError as e:
        die(f"cannot read file {src!r}: {e}")


def read_body(args):
    raw = read_text(args.body)
    try:
        return json.loads(raw)
    except json.JSONDecodeError as e:
        die(f"body is not valid JSON: {e}")


def parse_kv(spec, what):
    """Parse a `k=v,k2=v2` spec into a dict.

    Each value is JSON-decoded when it can be (`n=4` -> int, `s="ok"` -> str,
    `b=true` -> bool, `a=[1,2]` -> list), falling back to a bare string for an
    unquoted word (`s=ok` -> "ok"). Splits on commas, so a value that itself
    contains a comma needs a full `--body` instead.
    """
    out = {}
    for chunk in spec.split(","):
        chunk = chunk.strip()
        if not chunk:
            continue
        if "=" not in chunk:
            die(f"{what}: expected key=value, got {chunk!r}")
        key, _, raw = chunk.partition("=")
        key = key.strip()
        if not key:
            die(f"{what}: empty key in {chunk!r}")
        raw = raw.strip()
        try:
            out[key] = json.loads(raw)
        except json.JSONDecodeError:
            out[key] = raw
    return out


def parse_file_refs(spec, what):
    """Parse a comma-separated list of files into `file`-type DataRefs.

    The format hint is intentionally left off (the runner infers it); each entry
    becomes `{"type": "file", "id": <entry>}`.
    """
    refs = [{"type": "file", "id": f.strip()} for f in spec.split(",") if f.strip()]
    if not refs:
        die(f"{what}: must list at least one file")
    return refs


# ---- arg parsing -----------------------------------------------------------
def build_parser():
    p = argparse.ArgumentParser(
        prog="agent-cli", description="Query the atai agent_service API.")
    p.add_argument("--json", action="store_true",
                   help="print the raw JSON response instead of formatted output")
    sub = p.add_subparsers(dest="group", required=True)

    def add_json(sp):
        sp.add_argument("--json", action="store_true",
                        help="print raw JSON response")

    def add_yes(sp):
        sp.add_argument("-y", "--yes", action="store_true",
                        help="skip the cascade confirmation prompt (assume yes)")

    # blueprints
    bp = sub.add_parser("blueprints", help="blueprint catalog").add_subparsers(
        dest="cmd", required=True)
    s = bp.add_parser("list", help="GET /agents/blueprints")
    s.add_argument("--key"); s.add_argument("--limit", type=int)
    s.add_argument("--after"); add_json(s); s.set_defaults(func=cmd_blueprints_list)
    s = bp.add_parser("get", help="GET /agents/blueprints/{reference}")
    s.add_argument("reference", help="blp_ id or key (e.g. osm)")
    s.add_argument("--yaml", action="store_true", help="request the YAML rendering")
    add_json(s); s.set_defaults(func=cmd_blueprints_get)
    s = bp.add_parser("create", help="POST /agents/blueprints")
    src = s.add_mutually_exclusive_group(required=True)
    src.add_argument("--body", help="JSON request file, or - for stdin")
    src.add_argument("--yaml", help="YAML blueprint file (or -); stored verbatim, "
                                    "comments preserved. Requires --key")
    s.add_argument("--key", help="blueprint_key to register under (required with --yaml)")
    s.add_argument("--canonical", action="store_true",
                   help="publish platform-wide (needs super-admin); only with --yaml")
    add_json(s); s.set_defaults(func=cmd_blueprints_create)
    s = bp.add_parser("delete", help="DELETE /agents/blueprints/{reference}; "
                                     "on-demand cascade through bundles + agents")
    s.add_argument("reference", help="blp_ id or key (e.g. osm)")
    add_yes(s); s.set_defaults(func=cmd_blueprints_delete)

    # bundles
    bu = sub.add_parser("bundles", help="deployable bundles").add_subparsers(
        dest="cmd", required=True)
    s = bu.add_parser("list", help="GET /agents/bundle")
    s.add_argument("--limit", type=int); s.add_argument("--after")
    add_json(s); s.set_defaults(func=cmd_bundles_list)
    s = bu.add_parser("get", help="GET /agents/bundle/{id}")
    s.add_argument("bundle_id"); add_json(s); s.set_defaults(func=cmd_bundles_get)
    s = bu.add_parser("create", help="POST /agents/bundle")
    s.add_argument("--blueprint", help="blueprint to pin: blp_ id or key (e.g. osm)")
    s.add_argument("--name", help="human label for the bundle")
    s.add_argument("--description", help="optional human description")
    s.add_argument("--model", help="optional model override (else blueprint default)")
    s.add_argument("--values", metavar="K=V,...",
                   help="value overrides, e.g. 'foo=4,bar=\"ok\"' (values are "
                        "JSON-decoded; bare words stay strings)")
    s.add_argument("--artifacts", metavar="K=V,...",
                   help="artifact links, e.g. 'index=\"s3://.../knn\"'")
    s.add_argument("--body", help="full JSON file, or - for stdin "
                                  "(exclusive with the flags above)")
    add_json(s); s.set_defaults(func=cmd_bundles_create)
    s = bu.add_parser("delete", help="DELETE /agents/bundle/{id}; "
                                     "on-demand cascade through its agents")
    s.add_argument("bundle_id"); add_yes(s); s.set_defaults(func=cmd_bundles_delete)
    s = bu.add_parser("run", help="POST /agents/bundle/{id}/run")
    s.add_argument("bundle_id")
    s.add_argument("--source", metavar="FILE,...",
                   help="input file(s) for connectors.source, e.g. 'foo.csv,bar.csv'")
    s.add_argument("--sink", metavar="FILE",
                   help="optional single output file for connectors.sink")
    s.add_argument("--body", help="full JSON file (or -) with {\"connectors\": {...}} "
                                  "(exclusive with --source/--sink)")
    add_json(s); s.set_defaults(func=cmd_bundles_run)

    # agents / instances
    ag = sub.add_parser("agents", help="agent runs (instances)").add_subparsers(
        dest="cmd", required=True)
    s = ag.add_parser("list", help="GET /agents/instances")
    s.add_argument("--status", choices=["running", "paused", "completed",
                                         "failed", "canceled"])
    s.add_argument("--query", help="substring match over name/id/bundle/blueprint")
    s.add_argument("--limit", type=int); s.add_argument("--after")
    add_json(s); s.set_defaults(func=cmd_agents_list)
    s = ag.add_parser("get", help="GET /agents/instances/{id}")
    s.add_argument("agent_id"); add_json(s); s.set_defaults(func=cmd_agents_get)
    s = ag.add_parser("events", help="GET /agents/instances/{id}/events")
    s.add_argument("agent_id"); add_json(s); s.set_defaults(func=cmd_agents_events)
    s = ag.add_parser("results", help="GET /agents/instances/{id}/results")
    s.add_argument("agent_id"); s.add_argument("--offset", type=int)
    s.add_argument("--limit", type=int); add_json(s)
    s.set_defaults(func=cmd_agents_results)
    s = ag.add_parser("logs", help="GET /agents/instances/{id}/logs")
    s.add_argument("agent_id"); s.add_argument("--offset", type=int)
    s.add_argument("--limit", type=int); add_json(s)
    s.set_defaults(func=cmd_agents_logs)
    s = ag.add_parser("cancel", help="POST /agents/instances/{id}/cancel")
    s.add_argument("agent_id"); add_json(s); s.set_defaults(func=cmd_agents_cancel)
    s = ag.add_parser("pause", help="POST /agents/instances/{id}/pause")
    s.add_argument("agent_id"); add_json(s); s.set_defaults(func=cmd_agents_pause)
    s = ag.add_parser("resume", help="POST /agents/instances/{id}/resume")
    s.add_argument("agent_id"); add_json(s); s.set_defaults(func=cmd_agents_resume)
    s = ag.add_parser("delete", help="DELETE /agents/instances/{id}; "
                                     "cancels first if the agent is still active")
    s.add_argument("agent_id"); add_yes(s); s.set_defaults(func=cmd_agents_delete)

    # nodes
    nd = sub.add_parser("nodes", help="node registry").add_subparsers(
        dest="cmd", required=True)
    for name in ("registry", "list"):  # `list` is an alias for `registry`
        s = nd.add_parser(name, help="GET /agents/nodes/registry")
        s.add_argument("--schema", action="store_true",
                       help="also show each node's config schema + defaults")
        add_json(s); s.set_defaults(func=cmd_nodes_registry)

    return p


def main():
    parser = build_parser()
    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
