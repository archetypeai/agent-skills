# Copy to .env (here or in a parent folder) and fill in. A .env wins over the same
# names exported in your shell. Keys are per deployment: one issued for another 401s here.
# The od blueprint is on staging as of 2026-11.
ATAI_API_KEY=<your API key>
# The deployment root; a trailing /api is fine too
ATAI_API_ENDPOINT=https://platform.stage.u1.archetypeai.app
